# ===== 로컬 개발 환경 =====
# docker compose -f docker-compose.dev.yml up 으로 실행

# Django
SECRET_KEY=django-insecure-change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev

# Neo4j (로컬 Docker 컨테이너 — 기본값, 수정 불필요)
NEO4J_BOLT_URL=bolt://neo4j:secondif2024@neo4j:7687

# ===== 프로덕션 전용 (Railway Variables에서 설정) =====
# 아래 값들은 .env에 넣지 말 것. Railway 대시보드에서만 설정.
#
# SECRET_KEY=your_secret_key
# DJANGO_SETTINGS_MODULE=config.settings.prod
# NEO4J_BOLT_URL=your_neo4j_url
# ALLOWED_HOSTS=your_domain
# PORT=8000
# GRAFANA_CLOUD_API_KEY=your_api_key
# GRAFANA_CLOUD_PROM_URL=your_prom_url
# GRAFANA_CLOUD_LOKI_URL=your_loki_url
# EMAIL_HOST_USER=your_email
# EMAIL_HOST_PASSWORD=your_password
# RAILWAY_TOKEN=your_token
