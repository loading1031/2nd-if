# ===== 로컬 개발 환경 =====
# docker compose -f docker-compose.dev.yml up 으로 실행

# Django
SECRET_KEY=django-insecure-change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev

# Neo4j (로컬 Docker 컨테이너 — 기본값, 수정 불필요)
NEO4J_BOLT_URL=bolt://neo4j:secondif2024@neo4j:7687

# ===== 프로덕션 전용 (Railway Variables에서 설정) =====
# 아래 값들은 .env에 넣지 말 것. Railway 대시보드에서만 설정.
#
# SECRET_KEY=(자동 생성)
# DJANGO_SETTINGS_MODULE=config.settings.prod
# NEO4J_BOLT_URL=neo4j+s://neo4j:<PASSWORD>@<INSTANCE_ID>.databases.neo4j.io
# DB_PATH=/data/db.sqlite3 (Railway Volume, 기본값이므로 설정 불필요)
# ALLOWED_HOSTS=.up.railway.app,your-domain.com
# PORT=8000
# GRAFANA_CLOUD_API_KEY=glc_<YOUR_API_KEY>
# GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-xx.grafana.net/api/prom/push
# GRAFANA_CLOUD_LOKI_URL=https://logs-prod-xx.grafana.net/loki/api/v1/push
# EMAIL_HOST_USER=noreply@2nd-if.com
# EMAIL_HOST_PASSWORD=<APP_PASSWORD>
