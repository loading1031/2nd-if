# Django
SECRET_KEY=django-insecure-change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev

# Neo4j Aura
NEO4J_BOLT_URL=neo4j+s://neo4j:<PASSWORD>@<INSTANCE_ID>.databases.neo4j.io
NEO4J_URI=neo4j+s://<INSTANCE_ID>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<YOUR_NEO4J_PASSWORD>
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=<YOUR_INSTANCE_ID>
AURA_INSTANCENAME=Free instance

# PostgreSQL (production only — Fly.io auto-sets DATABASE_URL)
DATABASE_URL=postgres://user:password@localhost:5432/secondif

# Grafana Cloud (production only)
GRAFANA_CLOUD_API_KEY=glc_<YOUR_API_KEY>
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-xx.grafana.net/api/prom/push
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-xx.grafana.net/loki/api/v1/push

# Email (production only)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Fly.io
ALLOWED_HOSTS=localhost,127.0.0.1,.fly.dev
